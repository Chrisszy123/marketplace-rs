# Production secrets for docker-compose.prod.yml — copy to `.env` in this same directory and
# fill in real values. Never commit the real `.env`.

# The domain you pointed at this server's IP (A records for @, api, and media — see
# DEPLOYMENT.md). Do not include "https://" or a trailing slash.
DOMAIN=example.com

# Email Caddy uses for Let's Encrypt renewal notices. Any address you control.
CADDY_EMAIL=you@example.com

# Supabase Postgres connection string. Use the DIRECT connection (port 5432), not the pooled
# one (port 6543) — the pooled connection runs PgBouncer in transaction mode, which does not
# support the prepared statements sqlx uses by default and will fail under load.
# Format: postgres://postgres.<project-ref>:<password>@<host>:5432/postgres
DATABASE_URL=change-me

# Upstash Redis connection string (from the Upstash console — use the "redis://" or "rediss://"
# URL, not the REST API URL).
REDIS_URL=change-me

# Generate with: openssl rand -hex 24
MEILISEARCH_API_KEY=change-me

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me

# Credentials for the self-hosted MinIO instance (acts as the S3 access key/secret pair).
# Generate with: openssl rand -hex 12 / openssl rand -hex 24
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
