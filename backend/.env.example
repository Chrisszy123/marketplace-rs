DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/marketplace
REDIS_URL=redis://localhost:6379
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=marketplace_dev_master_key
SERVER_ADDR=0.0.0.0:8080

# Secret used to sign JWT access tokens. Generate a real one with e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# Frontend origin allowed by CORS (must be exact, no trailing slash).
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Whether the refresh-token cookie requires HTTPS. Keep false for local http dev; true in prod.
COOKIE_SECURE=false
