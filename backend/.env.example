DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/marketplace
REDIS_URL=redis://localhost:6379
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=marketplace_dev_master_key
SERVER_ADDR=0.0.0.0:8080

# Secret used to sign JWT access tokens. Generate a real one with e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# Frontend origin allowed by CORS (must be exact, no trailing slash).
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Whether the refresh-token cookie requires HTTPS. Keep false for local http dev; true in prod.
COOKIE_SECURE=false

# S3-compatible object storage (MinIO locally) for listing photos.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=marketplace
S3_SECRET_ACCESS_KEY=marketplace123
S3_BUCKET=marketplace-listings
S3_REGION=us-east-1
S3_PUBLIC_URL_BASE=http://localhost:9000/marketplace-listings
